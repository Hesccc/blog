# ==========================================
# 后端 Dockerfile (Python / Flask)
# ==========================================
FROM python:3.11-slim

# 设置工作目录与环境变量
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    FLASK_HOST=0.0.0.0 \
    FLASK_PORT=5000

# 安装系统级依赖（网络工具、gcc等，部分加密与图像库需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 先复制依赖定义，利用 Docker 缓存层
COPY pyproject.toml .

# 安装 pip 工具及后端生产依赖 (使用 pip 安装 pyproject.toml 中的依赖)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir gunicorn && \
    pip install --no-cache-dir .

# 复制后端业务源码
COPY apps/ ./apps/
COPY main.py .

# 创建持久化上传和临时缓存目录
RUN mkdir -p uploads temp/images temp/backups

# 暴露后端端口
EXPOSE 5000

# 生产环境使用 gunicorn 启动服务 (带 4 个工作进程，并开启支持 websocket / 长请求的超时设置)
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:5000", "--timeout", "120", "main:app"]
